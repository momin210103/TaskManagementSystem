# ==============================================================================
# Environment Configuration Template for Team Task Management System
# Copy this file to .env before running: docker compose up --build
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=TaskManagementDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Postgres@123
POSTGRES_PORT=5433

# Backend API Configuration
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication Configuration (Secret must be at least 32 characters)
JWT_SECRET=DevelopmentSecretKeyForTaskManagementSystem2026Net10!
JWT_ISSUER=TaskManagementAPI
JWT_AUDIENCE=TaskManagementClients
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api
